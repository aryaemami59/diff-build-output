{
  "name": "diff-build-output",
  "version": "0.0.1",
  "description": "view and compare the difference between multiple build outputs",
  "keywords": [
    "build",
    "diff",
    "compare",
    "output",
    "tool",
    "bundle",
    "analyze",
    "size"
  ],
  "homepage": "https://github.com/aryaemami59/diff-build-output/tree/master#readme",
  "bugs": {
    "url": "https://github.com/aryaemami59/diff-build-output/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryaemami59/diff-build-output.git"
  },
  "license": "MIT",
  "author": {
    "email": "aryaemami59@yahoo.com",
    "name": "Arya Emami",
    "url": "https://github.com/aryaemami59"
  },
  "maintainers": [
    {
      "email": "aryaemami59@yahoo.com",
      "name": "Arya Emami",
      "url": "https://github.com/aryaemami59"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "module": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "build": "yarn run clean && tsdown --config-loader='unrun' --config=$INIT_CWD/tsdown.config.mts",
    "clean": "rimraf diffs/ dist/ .rolldown/ temp/",
    "format": "prettier --ignore-path=$PROJECT_CWD/.gitignore --config=$PROJECT_CWD/prettier.config.mts --write $INIT_CWD",
    "format-check": "prettier --ignore-path=$PROJECT_CWD/.gitignore --config=$PROJECT_CWD/prettier.config.mts --check $INIT_CWD",
    "lint": "eslint --config=$PROJECT_CWD/eslint.config.mts $INIT_CWD",
    "lint-fix": "eslint --config=$PROJECT_CWD/eslint.config.mts --fix $INIT_CWD",
    "prepack": "yarn run build",
    "test": "node --enable-source-maps --test tests/**/*.test.ts",
    "typecheck": "tsc -p $INIT_CWD/tsconfig.json --noEmit"
  },
  "dependencies": {
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@arethetypeswrong/core": "^0.18.2",
    "@aryaemami59/eslint-config": "^0.0.7",
    "@aryaemami59/prettier-config": "^0.0.7",
    "@aryaemami59/tsconfig": "^0.0.7",
    "@aryaemami59/vitest-config": "^0.0.7",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.3",
    "eslint-plugin-package-json": "^0.89.4",
    "jiti": "^2.6.1",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "react": "^19.2.4",
    "react-redux": "^9.2.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.0-rc.7",
    "tsdown": "^0.21.0",
    "typescript": "^6.0.1-rc",
    "unplugin-unused": "^0.5.7",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
