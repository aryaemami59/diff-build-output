{
  "name": "diff-build-output",
  "version": "0.0.1",
  "description": "view and compare the difference between multiple build outputs",
  "keywords": [
    "build",
    "diff",
    "compare",
    "output",
    "tool",
    "bundle",
    "analyze",
    "size"
  ],
  "homepage": "https://github.com/aryaemami59/diff-build-output/tree/master#readme",
  "bugs": {
    "url": "https://github.com/aryaemami59/diff-build-output/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryaemami59/diff-build-output.git"
  },
  "license": "MIT",
  "author": {
    "email": "aryaemami59@yahoo.com",
    "name": "Arya Emami",
    "url": "https://github.com/aryaemami59"
  },
  "maintainers": [
    {
      "email": "aryaemami59@yahoo.com",
      "name": "Arya Emami",
      "url": "https://github.com/aryaemami59"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "module": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "build": "yarn run clean && tsdown --config-loader=unrun --config=${INIT_CWD}/tsdown.config.mts",
    "clean": "rimraf diffs/ dist/ .rolldown/ temp/",
    "format": "prettier --ignore-path=${PROJECT_CWD}/.gitignore --ignore-path=${PROJECT_CWD}/.prettierignore --config=${PROJECT_CWD}/prettier.config.mts --write ${INIT_CWD}",
    "format-check": "prettier --ignore-path=${PROJECT_CWD}/.gitignore --ignore-path=${PROJECT_CWD}/.prettierignore --config=${PROJECT_CWD}/prettier.config.mts --check ${INIT_CWD}",
    "lint": "eslint --config=${PROJECT_CWD}/eslint.config.mts ${INIT_CWD}",
    "lint-fix": "eslint --config=${PROJECT_CWD}/eslint.config.mts --fix ${INIT_CWD}",
    "prepack": "yarn run build",
    "test": "node --enable-source-maps --test tests/**/*.test.ts",
    "typecheck": "tsc -p ${INIT_CWD}/tsconfig.json --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@aryaemami59/eslint-config": "^0.0.8",
    "@aryaemami59/prettier-config": "^0.0.8",
    "@aryaemami59/tsconfig": "^0.0.8",
    "@aryaemami59/vitest-config": "^0.0.8",
    "@reduxjs/toolkit": "https://pkg.pr.new/@reduxjs/toolkit@62d21b0.tgz",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "eslint-plugin-package-json": "^1.6.2",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^3.1.0",
    "pkg-pr-new": "^0.0.80",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "https://pkg.pr.new/redux@28d433b.tgz",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.0",
    "tsdown": "^0.23.0-beta.1",
    "tsnapi": "^1.2.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "unplugin-unused": "^0.6.0",
    "unrun": "^0.3.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
