{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "lib": ["ESNext"],
    "libReplacement": false,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./",
    "verbatimModuleSyntax": true
  },
  "exclude": ["dist", "**/dist/", "__snapshots__/", "build/"],
  "extends": "@aryaemami59/tsconfig/nodenext/nodenext/with-js",
  "include": ["**/*.*"]
}
